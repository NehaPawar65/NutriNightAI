# Copy to .env and change the values. Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=nutrinight
POSTGRES_USER=nutrinight
POSTGRES_PASSWORD=change-me-db-password
# Host port used when the database runs in Docker (5432/5433 are often taken by local installs)
POSTGRES_HOST_PORT=5440

# --- Spring Boot backend ---
BACKEND_PORT=8085
DB_URL=jdbc:postgresql://localhost:5440/nutrinight
DB_USERNAME=nutrinight
DB_PASSWORD=change-me-db-password
NUTRINIGHT_TIMEZONE=Asia/Kolkata
# Credentials for admin-only actions (CSV upload, deleting orders)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:3000
# Internal URL of the Python AI service (inside Docker use http://ai-service:8001)
AI_SERVICE_URL=http://localhost:8001
# Shared secret sent by the backend to the AI service (never exposed to the browser)
AI_SERVICE_API_KEY=change-me-internal-key

# --- Python AI service ---
AI_SERVICE_PORT=8001

# --- Frontend ---
FRONTEND_PORT=3000
# Leave empty to use same-origin /api (Vite proxy / nginx). Set for Vercel deployments.
VITE_API_BASE_URL=
